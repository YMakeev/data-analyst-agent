# Скопіюй цей файл у .env:  cp .env.example .env
# Для воркшопу нічого міняти не треба — значення підходять до docker-compose.yml.

# --- Підключення MCP-сервера до бази ---------------------------------------
# УВАГА: користувач analyst_ro має право лише читати.
# Саме тому агент фізично не може нічого зіпсувати. Не міняй його на postgres.
DATABASE_URL=postgresql://analyst_ro:analyst_ro_pwd@localhost:5433/analytics

# --- Адмінське підключення (тільки для сідингу й тренування моделі) --------
# Використовується скриптами db/seed.py і ml/train.py, сервер його не бачить.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/analytics

# --- Поведінка інструментів ------------------------------------------------
SQL_TIMEOUT_SECONDS=15
SQL_MAX_ROWS=1000
REPORTS_DIR=./reports

# --- Транспорт -------------------------------------------------------------
# stdio — локально (Claude Desktop породжує сервер як дочірній процес)
# http  — у хмарі (один інстанс на всю команду)
MCP_TRANSPORT=stdio
PORT=8000
